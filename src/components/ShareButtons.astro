---
// Compact share bar with icons, shown at the top of a page. No third-party scripts: plain intent URLs,
// plus copy-link and the native share sheet (shown only where the browser supports it).
import { absolute, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Absolute page URL. */
  href: string;
  text: string;
}

const { lang, href, text } = Astro.props;
const s = t(lang);
const e = encodeURIComponent;
// Simple line icons (24×24), not brand logos.
const links = [
  { label: 'WhatsApp', url: `https://wa.me/?text=${e(`${text} ${href}`)}`, icon: '<path d="M4 20l1.3-3.9A8 8 0 1 1 8 18.8z"/><path d="M9 9.5c.5 2.5 2.5 4.5 5 5l1.2-1.2-2-1-.8.8a4 4 0 0 1-2-2l.8-.8-1-2z"/>' },
  { label: 'Telegram', url: `https://t.me/share/url?url=${e(href)}&text=${e(text)}`, icon: '<path d="M21 4L3 11l6 2.2L11 20l3.2-4 4.8 3.5z"/><path d="M9 13.2L21 4"/>' },
  { label: 'X', url: `https://x.com/intent/post?text=${e(text)}&url=${e(href)}`, icon: '<path d="M5 4l14 16M19 4L5 20"/>' },
  { label: 'Bluesky', url: `https://bsky.app/intent/compose?text=${e(`${text} ${href}`)}`, icon: '<path d="M12 11C10 7 6.5 4.5 4.5 5.3 3 6 4.5 11 8 12.3 5 13.5 5.5 17 8.5 17.3 10.5 17.5 12 14 12 11zm0 0c2-4 5.5-6.5 7.5-5.7 1.5.7 0 5.7-3.5 7 3 1.2 2.5 4.7-.5 5-2 .2-3.5-3.3-3.5-6.3z"/>' },
  { label: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${e(href)}`, icon: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10v6M8 7.5v.01M12 16v-6M12 12.5a2.5 2.5 0 0 1 5 0V16"/>' },
  { label: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${e(href)}`, icon: '<path d="M14.5 8H17V4.5h-2.5A4 4 0 0 0 10.5 8.5V11H8v3.5h2.5V21H14v-6.5h2.6l.6-3.5H14V8.6a.6.6 0 0 1 .5-.6z"/>' },
  { label: 'Email', url: `mailto:?subject=${e(text)}&body=${e(`${text}\n${href}`)}`, icon: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>' },
];
const linkIcon = '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>';
const embedIcon = '<path d="M8.5 7L3.5 12l5 5M15.5 7l5 5-5 5"/>';
// The embed lives at embed/<same path as the page>/; embed/<lang>/ always shows today's saint.
const embedSrc = absolute(`embed${new URL(href).pathname}`);
const embedToday = absolute(`embed/${lang}/`);
const shareIcon = '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.3 10.8l7.4-3.6M8.3 13.2l7.4 3.6"/>';
---

<div class="share" data-href={href} data-text={text} aria-label={s.share}>
  <button type="button" class="ic native" title={s.shareNative} aria-label={s.shareNative} hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={shareIcon} />
  </button>
  {
    links.map((l) => (
      <a class="ic" href={l.url} target="_blank" rel="noopener noreferrer" title={l.label} aria-label={`${s.share}: ${l.label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} />
      </a>
    ))
  }
  <button type="button" class="ic copy" title={s.copyLink} aria-label={s.copyLink} data-done={s.copied}>
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={linkIcon} />
  </button>
  <button type="button" class="ic embed-open" title={s.embed} aria-label={s.embed}>
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={embedIcon} />
  </button>
  <span class="copied" role="status" hidden>{s.copied}</span>
</div>

<dialog class="embed-dialog" aria-label={s.embedTitle} data-src={embedSrc} data-today={embedToday} data-title={text}>
  <h2>{s.embedTitle}</h2>
  <div class="opts">
    <label><input type="radio" name="embed-what" value="page" checked /> {s.embedThis}</label>
    <label><input type="radio" name="embed-what" value="today" /> {s.embedToday}</label>
    <label><input type="checkbox" name="embed-dark" /> {s.embedDark}</label>
  </div>
  <iframe class="preview" title={s.embed} loading="lazy"></iframe>
  <textarea readonly rows="4" spellcheck="false"></textarea>
  <div class="actions">
    <button type="button" class="embed-copy" data-done={s.copied}>{s.embedCopy}</button>
    <button type="button" class="embed-close">{s.close}</button>
  </div>
</dialog>

<script is:inline>
  document.querySelectorAll('.embed-dialog').forEach((dlg) => {
    const code = dlg.querySelector('textarea');
    const preview = dlg.querySelector('.preview');
    const copy = dlg.querySelector('.embed-copy');
    const label = copy.textContent;
    function update() {
      const today = dlg.querySelector('[name="embed-what"]:checked').value === 'today';
      const dark = dlg.querySelector('[name="embed-dark"]').checked;
      const src = (today ? dlg.dataset.today : dlg.dataset.src) + (dark ? '?theme=dark' : '');
      const title = today ? document.title.split(' · ').pop() : dlg.dataset.title;
      code.value = `<iframe src="${src}" width="480" height="220" style="border:0;max-width:100%" title="${title.replace(/"/g, '&quot;')}" loading="lazy"></iframe>`;
      if (preview.getAttribute('src') !== src) preview.src = src;
    }
    dlg.querySelectorAll('input').forEach((i) => i.addEventListener('change', update));
    document.querySelector('.embed-open')?.addEventListener('click', () => {
      update();
      dlg.showModal();
    });
    dlg.querySelector('.embed-close').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
    code.addEventListener('focus', () => code.select());
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.value);
        copy.textContent = copy.dataset.done;
        setTimeout(() => (copy.textContent = label), 1800);
      } catch {
        code.select();
      }
    });
  });

  document.querySelectorAll('.share').forEach((box) => {
    const { href, text } = box.dataset;
    const native = box.querySelector('.native');
    if (navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title: text, text, url: href }).catch(() => {}));
    }
    const done = box.querySelector('.copied');
    box.querySelector('.copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(href);
        done.hidden = false;
        setTimeout(() => (done.hidden = true), 1800);
      } catch {
        prompt('', href);
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    margin: 0 0 10px;
  }
  .ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--red);
    cursor: pointer;
  }
  .ic:hover {
    border-color: var(--gold);
  }
  .ic svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 640px) {
    .share {
      justify-content: center;
    }
  }
  .embed-dialog {
    width: min(540px, calc(100vw - 32px));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    padding: 18px;
  }
  .embed-dialog::backdrop {
    background: rgb(20 14 10 / 0.6);
  }
  .embed-dialog h2 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }
  .embed-dialog .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 0.9rem;
    margin-bottom: 12px;
  }
  .embed-dialog .preview {
    display: block;
    width: 100%;
    height: 220px;
    border: 0;
    margin-bottom: 10px;
  }
  .embed-dialog textarea {
    width: 100%;
    font: 0.78rem/1.4 ui-monospace, Menlo, monospace;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px;
    resize: none;
  }
  .embed-dialog .actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .embed-dialog .actions button {
    font: inherit;
    font-variant: small-caps;
    color: var(--red);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 14px;
    cursor: pointer;
  }
  .copied {
    font-size: 0.75rem;
    color: var(--muted);
    margin-left: 4px;
  }
</style>
