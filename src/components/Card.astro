---
// A holy card (any kind) with a caption under it.
interface Props {
  svg: string;
  /** Back of the card (SVG markup): full-screen flip viewer and downloads. */
  back?: string;
  name?: string;
  lang: 'it' | 'en';
}

import CardDownloads from './CardDownloads.astro';
const { svg, back, name = 'santino', lang } = Astro.props;
---

<div class="cardcol">
  <figure class="santino" data-name={name}>
    <Fragment set:html={svg} />
    {back && <template class="card-back" set:html={back} />}
    <figcaption><slot /></figcaption>
  </figure>
  {back && <CardDownloads lang={lang} />}
</div>

<style>
  .cardcol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 260px;
  }
  .santino {
    margin: 0;
    width: 100%;
  }
  .santino :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.18));
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
  }
</style>
