---
// Search page. The categories (most dangerous, most exploited, …) are search filters:
// they combine with the text query, and pick the order and score shown.
import Base from '../layouts/Base.astro';
import { listConfig } from '../lib/saint-list';
import { t, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'it' ? 'en' : 'it';
const categories = Object.entries(s.rankings) as [string, { label: string; note: string }][];
const config = { ...listConfig(s, lang, url('')), rankings: s.rankings, yearsLabel: s.yearsAlive };
---

<Base lang={lang} title={s.search} alt={`${other}/${t(other).searchSlug}`}>
  <h1>{s.search}</h1>
  <div id="search" data-config={JSON.stringify(config)}>
    <input id="q" type="search" placeholder={s.searchPlaceholder} autofocus autocomplete="off" />
    <div class="chips">
      {categories.map(([key, r]) => <button type="button" data-cat={key} aria-pressed="false">{r.label}</button>)}
    </div>
    <p id="note" class="note" hidden></p>
    <ol id="results" class="saint-list"></ol>
    <p id="empty" hidden>{s.searchEmpty}</p>
  </div>
</Base>

<script>
  import { byFame, loadIndex, readConfig, saintListItem, type IndexEntry, type ListConfig } from '../lib/saint-list';

  type Config = ListConfig & { rankings: Record<string, { label: string; note: string }>; yearsLabel: string };
  type Category = { filter: (v: IndexEntry) => boolean; sort: (a: IndexEntry, b: IndexEntry) => number; score: (v: IndexEntry) => string };

  const root = document.getElementById('search')!;
  const cfg = readConfig<Config>(root);
  const q = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results')!;
  const note = document.getElementById('note')!;
  const empty = document.getElementById('empty')!;
  const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  // Each category: which entries qualify, how they sort, and what score to show.
  const isSaint = (v: IndexEntry) => ['santo', 'beato', 'padre'].includes(v.k);
  const byYear = (a: IndexEntry, b: IndexEntry) => a.y.localeCompare(b.y);
  const CATEGORIES: Record<string, Category> = {
    famous: { filter: isSaint, sort: byFame, score: (v) => `★ ${v.f.toFixed(1)}` },
    dangerous: { filter: (v) => v.v != null, sort: (a, b) => b.v! - a.v! || byFame(a, b), score: (v) => `CVSS ${v.v!.toFixed(1)}` },
    exploited: {
      filter: (v) => !!v.x,
      sort: (a, b) => Number(b.r) - Number(a.r) || (b.v ?? 0) - (a.v ?? 0) || byFame(a, b),
      score: (v) => (v.r ? 'KEV · ransomware' : 'KEV'),
    },
    longest: { filter: (v) => v.l != null, sort: (a, b) => b.l! - a.l! || byFame(a, b), score: (v) => cfg.yearsLabel.replace('N', String(v.l)) },
    absurd: { filter: (v) => !!v.a, sort: byFame, score: () => '' },
    fathers: { filter: (v) => v.k === 'padre', sort: byYear, score: () => '' },
    blessed: { filter: (v) => v.k === 'beato', sort: byFame, score: () => '' },
    minor: { filter: (v) => !!v.m, sort: (a, b) => (a.d ?? '').localeCompare(b.d ?? ''), score: () => '' },
    scourges: { filter: (v) => v.k === 'flagello', sort: byYear, score: () => '' },
    miracles: { filter: (v) => v.k === 'miracolo', sort: byYear, score: () => '' },
    demons: { filter: (v) => v.k === 'demone', sort: byYear, score: () => '' },
  };

  const params = new URLSearchParams(location.search);
  let category: string | null = CATEGORIES[params.get('r') ?? ''] ? params.get('r') : null;
  let index: IndexEntry[] = [];

  function render() {
    const term = norm(q.value.trim());
    const byText = term.length >= 2;
    // With nothing typed or picked, the page isn't empty: it shows the most famous saints.
    const idle = !byText && !category;
    const cat = category ? CATEGORIES[category] : idle ? CATEGORIES.famous : null;
    root.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === category)));
    note.hidden = !category;
    note.textContent = category ? cfg.rankings[category].note : '';
    results.classList.toggle('ranked', !!cat);
    results.replaceChildren();
    empty.hidden = true;

    let hits = index;
    if (cat) hits = hits.filter(cat.filter);
    if (byText) hits = hits.filter((v) => norm(`${v.n} ${v.q}`).includes(term));
    hits = [...hits].sort(cat ? cat.sort : (a, b) => Number(!!b.s) - Number(!!a.s) || byFame(a, b)).slice(0, idle ? 20 : cat ? 100 : 50);
    empty.hidden = hits.length > 0;
    hits.forEach((v) => results.append(saintListItem(cfg, v, cat?.score(v))));

    const qs = new URLSearchParams();
    if (q.value) qs.set('q', q.value);
    if (category) qs.set('r', category);
    history.replaceState(null, '', qs.toString() ? '?' + qs : location.pathname);
  }

  q.value = params.get('q') ?? '';
  q.addEventListener('input', render);
  root.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) =>
    b.addEventListener('click', () => {
      category = category === b.dataset.cat ? null : b.dataset.cat!;
      render();
    }),
  );
  loadIndex(cfg.base, cfg.lang).then((data) => {
    index = data;
    render();
  });
</script>

<style>
  h1 {
    font-variant: small-caps;
  }
  input {
    width: 100%;
    font: inherit;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 8px;
  }
  .chips button {
    font: inherit;
    font-size: 0.9rem;
    padding: 2px 14px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    border-radius: 999px;
    cursor: pointer;
  }
  .chips button[aria-pressed='true'] {
    background: var(--red);
    border-color: var(--red);
    color: var(--paper);
  }
  .note {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
    margin: 0 0 8px;
  }
</style>
