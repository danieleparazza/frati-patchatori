---
// Band above the saint listing the movable feasts of this day. Feasts depend on the year
// (Patch Tuesday moves every month), so they are computed in the browser for the current year.
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  mmdd: string;
}

const { lang, mmdd } = Astro.props;
---

<aside class="feasts" data-lang={lang} data-mmdd={mmdd} hidden></aside>

<script>
  import { feastsOn } from '../lib/feasts';

  document.querySelectorAll<HTMLElement>('.feasts').forEach((band) => {
    const lang = band.dataset.lang as 'it' | 'en';
    const [m, d] = band.dataset.mmdd!.split('-').map(Number);
    const year = Number(new URLSearchParams(location.search).get('y')) || new Date().getFullYear();
    const feasts = feastsOn(new Date(year, m - 1, d));
    for (const f of feasts) {
      const t = f[lang];
      const item = document.createElement('div');
      item.className = 'feast';
      const name = document.createElement('strong');
      name.textContent = `✠ ${t.name}`;
      const text = document.createElement('span');
      text.textContent = ` ${t.text} `;
      const proverb = document.createElement('em');
      proverb.textContent = t.proverb;
      item.append(name, text, proverb);
      band.append(item);
    }
    band.hidden = feasts.length === 0;
  });
</script>

<style>
  .feasts {
    max-width: 720px;
    margin: 0 auto 24px;
    padding: 10px 16px;
    border: 1px solid var(--gold);
    border-left-width: 4px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--gold) 10%, var(--paper));
    font-size: 0.9rem;
  }
  .feasts :global(.feast + .feast) {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px dotted var(--line);
  }
  .feasts :global(strong) {
    color: var(--red);
    font-variant: small-caps;
  }
  .feasts :global(em) {
    color: var(--muted);
  }
</style>
