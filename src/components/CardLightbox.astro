---
// Full-screen viewer for holy cards (figure.santino). When the figure carries a back (SVG in a
// <template>), it shows the vertical card and turns it over (CSS 3D) on click or with the button.
// Esc or a click outside closes it. Included once by the layout.
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const s = t(Astro.props.lang);
---

<dialog class="lightbox" aria-label="Santino">
  <div class="stage"></div>
  <div class="controls">
    <button type="button" class="flip-btn">⟲ {s.flip}</button>
    <button type="button" class="close-btn">{s.close}</button>
    <button type="button" class="sound-btn" data-mute={s.mute} data-unmute={s.unmute}></button>
  </div>
</dialog>

<script>
  import { cardSvgs } from '../lib/card-client';
  import { muted, playClose, playReveal, setMuted } from '../lib/sfx';

  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const stage = dialog.querySelector<HTMLElement>('.stage')!;
  const flipBtn = dialog.querySelector<HTMLButtonElement>('.flip-btn')!;
  let card: HTMLElement | null = null;

  const soundBtn = dialog.querySelector<HTMLButtonElement>('.sound-btn')!;
  function showSound() {
    soundBtn.textContent = muted() ? '🔕' : '🔔';
    soundBtn.setAttribute('aria-label', muted() ? soundBtn.dataset.unmute! : soundBtn.dataset.mute!);
    soundBtn.title = soundBtn.getAttribute('aria-label')!;
  }
  showSound();
  soundBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    setMuted(!muted());
    showSound();
  });

  const flip = () => {
    if (!card) return;
    (card.classList.toggle('flipped') ? playReveal : playClose)();
  };

  function open(fig: HTMLElement) {
    const { front, back } = cardSvgs(fig);
    if (!front) return;
    if (back) {
      // Vertical card that turns over: front is the card, back the prayer side.
      card = document.createElement('div');
      card.className = 'flipcard';
      const inner = document.createElement('div');
      inner.className = 'inner';
      front.classList.add('face', 'front');
      back.classList.add('face', 'back');
      inner.append(front, back);
      card.append(inner);
      card.addEventListener('click', (e) => {
        e.stopPropagation();
        flip();
      });
      stage.replaceChildren(card);
      flipBtn.hidden = false;
    } else {
      card = null;
      front.classList.add('svgcard');
      stage.replaceChildren(front);
      flipBtn.hidden = true;
    }
    dialog.showModal();
    // Opening turns the card over: the back is the side people haven't seen yet.
    if (card) requestAnimationFrame(() => requestAnimationFrame(flip));
  }

  /** Turns the card back to its front, then closes. */
  function close() {
    if (!card?.classList.contains('flipped') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      dialog.close();
      return;
    }
    flip();
    setTimeout(() => dialog.close(), 650);
  }

  document.querySelectorAll<HTMLElement>('figure.santino').forEach((fig) => {
    const svg = fig.querySelector<SVGElement>(':scope > svg');
    if (!svg) return;
    svg.setAttribute('tabindex', '0');
    svg.setAttribute('role', 'button');
    svg.classList.add('zoomable');
    svg.addEventListener('click', () => open(fig));
    svg.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open(fig);
      }
    });
  });

  flipBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    flip();
  });
  dialog.querySelector('.close-btn')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === stage) close();
  });
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
</script>

<style>
  :global(svg.zoomable) {
    cursor: zoom-in;
    transition: transform 0.25s ease;
  }
  :global(svg.zoomable:hover) {
    transform: translateY(-3px) scale(1.015);
  }
  /* The page's main card hints that it turns over: a small tilt every few seconds. */
  :global(.cardcol svg.zoomable) {
    animation: card-hint 5s ease-in-out 1s infinite;
  }
  @keyframes card-hint {
    0%,
    78%,
    100% {
      transform: perspective(900px) rotateY(0);
    }
    84% {
      transform: perspective(900px) rotateY(-22deg) scale(1.03);
    }
    90% {
      transform: perspective(900px) rotateY(12deg) scale(1.03);
    }
    95% {
      transform: perspective(900px) rotateY(-3deg);
    }
  }
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    /* dvh: the visible height, without the area behind the phone browser's toolbars. */
    max-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgb(20 14 10 / 0.88);
  }
  .stage {
    width: 100%;
    height: calc(100% - 64px - env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1600px;
  }
  .controls {
    height: calc(64px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
  }
  .controls button {
    font: inherit;
    font-size: 0.95rem;
    font-variant: small-caps;
    color: #fbf3dd;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(251 243 221 / 0.4);
    border-radius: 999px;
    padding: 6px 16px;
    cursor: pointer;
  }
  /* Vertical card, 2:3, as large as the viewport allows. */
  .stage :global(.flipcard) {
    height: min(100%, calc((100vw - 32px) * 1.5));
    aspect-ratio: 2 / 3;
    cursor: pointer;
  }
  .stage :global(.inner) {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .stage :global(.flipcard.flipped .inner) {
    transform: rotateY(180deg);
  }
  .stage :global(.face) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
  }
  .stage :global(.face.back) {
    transform: rotateY(180deg);
  }
  .stage :global(.svgcard) {
    display: block;
    height: min(100%, 150vw);
    width: auto;
    max-width: 96vw;
    filter: drop-shadow(0 10px 30px rgb(0 0 0 / 0.5));
  }
  @media (prefers-reduced-motion: reduce) {
    .stage :global(.inner) {
      transition: none;
    }
    :global(.cardcol svg.zoomable) {
      animation: none !important;
    }
  }
</style>
