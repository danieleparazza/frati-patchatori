---
// Links to subscribe to the iCal feeds (saints, observances), shown on every page by the layout.
import { absolute, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const feeds = [
  { label: s.subscribeSaints, ics: absolute(`calendar/${lang}.ics`) },
  { label: s.subscribeFeasts, ics: absolute(`calendar/feasts/${lang}.ics`) },
].map((f) => ({ ...f, webcal: f.ics.replace(/^https:/, 'webcal:') }));
---

<section class="subscribe">
  <span class="label">📅 {s.subscribe}</span>
  {
    feeds.map((f) => (
      <p class="feed">
        <span class="name">{f.label}</span>
        <span class="chips">
          {/* Google expects the feed URL unencoded in cid. */}
          <a href={`https://calendar.google.com/calendar/render?cid=${f.webcal}`} target="_blank" rel="noopener noreferrer">
            {s.subscribeGoogle}
          </a>
          <a href={f.webcal}>{s.subscribeIcs}</a>
          <button type="button" class="copy-ics" data-url={f.ics} data-done={s.copied}>
            {s.copyIcs}
          </button>
        </span>
      </p>
    ))
  }
  <p class="note">{s.subscribeNote}</p>
</section>

<script is:inline>
  document.querySelectorAll('.copy-ics').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url);
        const label = b.textContent;
        b.textContent = b.dataset.done;
        setTimeout(() => (b.textContent = label), 1800);
      } catch {
        prompt('', b.dataset.url);
      }
    }),
  );
</script>

<style>
  .subscribe {
    max-width: 880px;
    margin: 0 auto;
    padding: 4px 16px 14px;
    text-align: center;
    font-size: 0.9rem;
  }
  .label {
    font-variant: small-caps;
    color: var(--gold);
  }
  .feed {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    justify-content: center;
    align-items: center;
  }
  .name {
    color: var(--muted);
  }
  .chips {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .chips a,
  .copy-ics {
    font: inherit;
    font-size: 0.82rem;
    color: var(--red);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px;
    text-decoration: none;
    cursor: pointer;
  }
  .chips a:hover,
  .copy-ics:hover {
    border-color: var(--gold);
  }
  /* Phones: the feed name on its own line, the three options under it. */
  @media (max-width: 640px) {
    .feed {
      flex-direction: column;
      gap: 4px;
    }
  }
  .note {
    margin: 6px 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
