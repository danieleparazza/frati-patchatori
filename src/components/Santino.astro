---
// Holy card: the generated SVG in src/data/santini/<id>.svg when present, otherwise a template.
import type { Vuln } from '../lib/calendar';
import { santino } from '../lib/santino';

interface Props {
  vuln: Vuln;
  /** Back of the card (SVG markup) for the full-screen flip viewer and downloads. */
  back?: string;
}

const { svg } = santino(Astro.props.vuln);
const { back } = Astro.props;
---

<figure class="santino" data-name={Astro.props.vuln.id} data-sound={Astro.props.vuln.category}>
  <Fragment set:html={svg} />
  {back && <template class="card-back" set:html={back} />}
  <figcaption><slot /></figcaption>
</figure>

<style>
  .santino {
    margin: 0;
    width: 100%;
    max-width: 260px;
  }
  .santino :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.18));
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
  }
</style>
