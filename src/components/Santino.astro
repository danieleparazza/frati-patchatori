---
// Holy card: the generated SVG in src/data/santini/<id>.svg when present, otherwise a template.
import type { Vuln } from '../lib/calendar';
import { santino } from '../lib/santino';

interface Props {
  vuln: Vuln;
  /** Complete holy card (share image) shown full screen on click. */
  full?: string;
}

const { svg } = santino(Astro.props.vuln);
const { full } = Astro.props;
---

<figure class="santino" data-full={full}>
  <Fragment set:html={svg} />
  <figcaption><slot /></figcaption>
</figure>

<style>
  .santino {
    margin: 0;
    width: 100%;
    max-width: 260px;
  }
  .santino :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.18));
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
  }
</style>
