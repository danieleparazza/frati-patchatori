---
// Holy card. Uses the generated SVG in src/data/santini/<id>.svg when present,
// otherwise draws a provisional card from a template.
import { santinoSvg, type Vuln } from '../lib/calendar';

interface Props {
  vuln: Vuln;
  title: string;
}

const { vuln, title } = Astro.props;
const svg = santinoSvg(vuln.id);
const accent = vuln.category === 'beato' ? '#2f5d8a' : vuln.category === 'padre' ? '#5b3a7a' : '#9e1b1b';
const initial = [...vuln.name.replace(/[^\p{L}\p{N}]/gu, '')][0]?.toUpperCase() ?? '?';
---

<figure class="santino">
  {
    svg ? (
      <Fragment set:html={svg} />
    ) : (
      <svg viewBox="0 0 300 450" role="img" aria-label={title}>
        <defs>
          <radialGradient id={`halo-${vuln.id}`}>
            <stop offset="55%" stop-color="#f5d77a" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#f5d77a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="300" height="450" rx="14" fill="#fbf3dd" />
        <rect x="10" y="10" width="280" height="430" rx="10" fill="none" stroke="#b8892b" stroke-width="4" />
        <rect x="20" y="20" width="260" height="410" rx="6" fill="none" stroke="#b8892b" stroke-width="1" />
        <circle cx="150" cy="170" r="105" fill={`url(#halo-${vuln.id})`} />
        <circle cx="150" cy="170" r="70" fill="none" stroke="#d9ad55" stroke-width="3" />
        <text x="150" y="200" text-anchor="middle" font-family="Georgia, serif" font-size="90" fill={accent}>
          {initial}
        </text>
        <path d="M30 340 h240 l-14 22 l14 22 h-240 l14 -22 z" fill={accent} />
        <text x="150" y="369" text-anchor="middle" font-family="Georgia, serif" font-size="20" fill="#fbf3dd">
          {vuln.name.length > 22 ? `${vuln.name.slice(0, 21)}…` : vuln.name}
        </text>
        <text x="150" y="412" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="#7a6656">
          {vuln.cves[0] ?? vuln.date.slice(0, 4)}
        </text>
      </svg>
    )
  }
  <figcaption><slot /></figcaption>
</figure>

<style>
  .santino {
    margin: 0;
    width: 100%;
    max-width: 260px;
  }
  .santino :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.18));
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
  }
</style>
