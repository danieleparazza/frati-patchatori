---
import Base from '../../layouts/Base.astro';
import SaintProfile from '../../components/SaintProfile.astro';
import FeastBand from '../../components/FeastBand.astro';
import ViewNav from '../../components/ViewNav.astro';
import { DAYS, day, dayLabel, neighbours, saint, saintTitle } from '../../lib/calendar';
import { LANGS, absolute, saintPath, t, url, type Lang } from '../../lib/i18n';
import { vacantSantino } from '../../lib/santino';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => DAYS.map((d) => ({ params: { lang, day: d } })));
}

const lang = Astro.params.lang as Lang;
const mmdd = Astro.params.day as string;
const s = t(lang);
const { patron, others } = day(mmdd);
const { prev, next } = neighbours(mmdd);
const title = patron ? saintTitle(patron, lang) : s.vacant;
const label = dayLabel(mmdd, lang);
const image = `og/${lang}/${mmdd}.png`;
---

<Base
  lang={lang}
  title={`${label} · ${title}`}
  description={(patron && saint(patron.id)?.[lang]?.patronage) ?? patron?.description ?? s.vacantText}
  alt={`${lang === 'it' ? 'en' : 'it'}/${mmdd}`}
  image={image}
>
  <ViewNav lang={lang} view="day" mmdd={mmdd} />
  <div class="dayhead">
    <a href={url(`${lang}/${prev}`)} aria-label={s.prevDay} rel="prev">‹</a>
    <h1>{label}</h1>
    <a href={url(`${lang}/${next}`)} aria-label={s.nextDay} rel="next">›</a>
  </div>
  <FeastBand lang={lang} mmdd={mmdd} />

  {
    patron ? (
      <SaintProfile
        vuln={patron}
        lang={lang}
        shareUrl={absolute(`${lang}/${mmdd}`)}
        shareText={`${label} · ${title}`}
        image={url(image)}
        imageName={`${mmdd}-${patron.id}.png`}
      />
    ) : (
      <article class="card vacant">
        <div class="vacant-card" set:html={vacantSantino(s.vacant)} />
        <h2>{s.vacant}</h2>
        <p>{s.vacantText}</p>
      </article>
    )
  }

  {
    others.length > 0 && (
      <section class="others">
        <h3>{s.alsoRemembered}</h3>
        <ul>
          {others.map((o) => (
            <li>
              <a href={url(saintPath(lang, o.id))}>{saintTitle(o, lang)}</a>
              <span class="year">({o.date.slice(0, 4)})</span>
              {o.cves.slice(0, 2).map((c) => (
                <span class="badge">{c}</span>
              ))}
              {o.kev && <span class="badge kev">KEV</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <p class="hint">{s.keyboardHint}</p>
</Base>

<style>
  .dayhead {
    /* Fixed columns: the arrows stay put whatever the length of the title. */
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    align-items: center;
    justify-items: center;
    gap: 8px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 24px;
  }
  .dayhead h1 {
    margin: 0;
    font-size: 2.2rem;
    font-variant: small-caps;
    text-align: center;
  }
  .dayhead a {
    font-size: 2.4rem;
    text-decoration: none;
    line-height: 1;
    padding: 0 8px;
  }
  .others {
    margin-top: 32px;
  }
  .others h3 {
    margin: 0 0 8px;
    font-variant: small-caps;
    color: var(--gold);
  }
  .others ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .others li {
    padding: 6px 0;
    border-bottom: 1px dotted var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
  }
  .year {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .vacant {
    text-align: center;
  }
  .vacant-card {
    width: 160px;
    margin: 0 auto;
  }
  .vacant-card :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .hint {
    margin-top: 32px;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
</style>
