---
// API reference: Swagger UI over public/api/openapi.yaml.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>API · Lunario dei Frati Patchatori</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css" />
    <style>
      body {
        margin: 0;
        background: #fff;
      }
      .back {
        display: block;
        padding: 10px 20px;
        font: 15px Georgia, serif;
        background: #f6efe0;
        color: #9e1b1b;
        border-bottom: 1px solid #e2d4b8;
      }
    </style>
  </head>
  <body>
    <a class="back" href="/">← Lunario dei Frati Patchatori</a>
    <div id="swagger"></div>
    <script is:inline src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js"></script>
    <script is:inline>
      SwaggerUIBundle({ url: '/api/openapi.yaml', dom_id: '#swagger', deepLinking: true, tryItOutEnabled: true });
    </script>
  </body>
</html>
