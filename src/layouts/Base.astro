---
import AppLinks from '../components/AppLinks.astro';
import CardLightbox from '../components/CardLightbox.astro';
import SubscribeLinks from '../components/SubscribeLinks.astro';
import { t, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page in the other language, without base. */
  alt?: string;
  /** Share image path, without base. */
  image?: string;
}

const { lang, title, description, alt, image } = Astro.props;
const s = t(lang);
// Pages without their own card (home, lists, search) share the site cover.
const imageUrl = new URL(url(image ?? `img/${lang}/site/home.jpg`), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const desc = description ?? s.siteBlurb;
const other: Lang = lang === 'it' ? 'en' : 'it';
// Menu entry for this page: Popes and demons belong to their lists, everything else to the calendar.
const [langSeg, first = ''] = Astro.url.pathname.split('/').filter(Boolean);
const calendarPages = [s.weekSlug, s.monthSlug, s.saintSlug, s.scourgeSlug, s.miracleSlug, ''];
const section =
  first === s.searchSlug ? 'search'
  : first === s.popesSlug || first === s.popeSlug ? 'popes'
  : first === s.bestiarySlug || first === s.demonSlug ? 'bestiary'
  : first === s.infoSlug ? 'info'
  : langSeg === lang && (/^\d\d-\d\d$/.test(first) || calendarPages.includes(first)) ? 'calendar'
  : null;
const fullTitle = title ? `${title} · ${s.siteTitle}` : s.siteTitle;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:title" content={title ?? s.siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={s.siteTitle} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? s.siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? s.siteTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl} />
    {alt && <link rel="alternate" hreflang={lang} href={pageUrl} />}
    {alt && <link rel="alternate" hreflang={other} href={new URL(url(alt), Astro.site).href} />}
    {alt && <link rel="alternate" hreflang="x-default" href={new URL(url(''), Astro.site).href} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={url(`manifest-${lang}.webmanifest`)} />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f6efe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1411" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content={lang === 'it' ? 'Frati Patchatori' : 'Patching Friars'} />
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href={url(`${lang}/`)}>
        <span class="brand-title">{s.siteTitle}</span>
        <span class="brand-tagline">{s.tagline}</span>
      </a>
      <nav class="mainnav">
        {
          [
            { key: 'calendar', href: url(`${lang}/`), label: s.calendar, icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
            { key: 'search', href: url(`${lang}/${s.searchSlug}`), label: s.search, icon: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>' },
            { key: 'popes', href: url(`${lang}/${s.popesSlug}`), label: s.popes, icon: '<path d="M6 21h12M7.5 21V12a4.5 4.5 0 0 1 9 0v9M8 15h8M8.5 12h7M12 3.5v3M10.5 5h3"/>' },
            { key: 'bestiary', href: url(`${lang}/${s.bestiarySlug}`), label: s.bestiary, icon: '<path d="M6 3.5l2.5 5M18 3.5l-2.5 5"/><circle cx="12" cy="14" r="6.5"/><path d="M9.5 13h.01M14.5 13h.01M10 17.5h4"/>' },
            { key: 'info', href: url(`${lang}/${s.infoSlug}`), label: s.info, icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5h.01"/>' },
          ].map((item) => (
            <a href={item.href} class:list={{ active: item.key === section }} aria-current={item.href === Astro.url.pathname ? 'page' : undefined}>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
              <span class="lbl">{item.label}</span>
            </a>
          ))
        }
        <a class="lang" href={url(alt ?? `${other}/`)} hreflang={other}>{other.toUpperCase()}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <AppLinks lang={lang} />
    <SubscribeLinks lang={lang} />
    <CardLightbox lang={lang} />
    <footer>
      <p>
        {s.footerData} <a href="https://vulnerability.garden">Vulnerability Garden</a> (Shellsharks, CC BY-SA 4.0),{' '}
        <a href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog">CISA KEV</a>,{' '}
        <a href="https://github.com/CVEProject/cvelistV5">CVE List</a>.
      </p>
      <p>{s.footerAi}</p>
      <p>
        {s.footerLicense} · <a href="https://github.com/danieleparazza/frati-patchatori">github.com/danieleparazza/frati-patchatori</a> · <a href="/api/">API</a>
      </p>
    </footer>
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6efe0;
    --paper: #fffaf0;
    --ink: #2b1d14;
    --muted: #7a6656;
    --red: #9e1b1b;
    --gold: #b8892b;
    --line: #e2d4b8;
    --kev: #9e1b1b;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1411;
      --paper: #241c17;
      --ink: #f1e6d4;
      --muted: #b09c88;
      --red: #e0645a;
      --gold: #d9ad55;
      --line: #3d3128;
      --kev: #e0645a;
      color-scheme: dark;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 18px;
    line-height: 1.5;
  }
  a {
    color: var(--red);
  }
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  .masthead {
    border-bottom: 3px double var(--gold);
    padding: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: baseline;
    justify-content: space-between;
    max-width: 880px;
    margin: 0 auto;
  }
  .brand {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-size: 1.4rem;
    font-weight: 700;
    font-variant: small-caps;
    letter-spacing: 0.03em;
    color: var(--red);
  }
  .brand-tagline {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
  }
  .mainnav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-variant: small-caps;
  }
  .mainnav a {
    text-decoration: none;
    color: var(--muted);
    border-bottom: 2px solid transparent;
  }
  .mainnav a:hover {
    color: var(--red);
  }
  .mainnav a.active {
    color: var(--red);
    font-weight: 600;
    border-bottom-color: var(--gold);
  }
  .mainnav .ico {
    display: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 640px) {
    /* Phones: a compact header, the tagline hides and the menu becomes a row of icons. */
    .masthead {
      padding: 8px 12px 6px;
      gap: 6px;
    }
    .brand-title {
      font-size: 1.1rem;
    }
    .brand-tagline {
      display: none;
    }
    .mainnav {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }
    .mainnav a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
      min-width: 44px;
    }
    .mainnav .ico {
      display: block;
    }
    .mainnav .lbl {
      font-size: 0.62rem;
      line-height: 1;
    }
    .mainnav .lang {
      align-self: center;
      padding: 2px 6px;
    }
  }
  .mainnav .lang {
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 6px;
  }
  footer {
    max-width: 880px;
    margin: 0 auto;
    padding: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }
  footer p {
    margin: 4px 0;
  }
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px 20px;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-family: ui-monospace, Menlo, monospace;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 6px;
    white-space: nowrap;
  }
  .badge.kev {
    border-color: var(--kev);
    color: var(--kev);
  }
  /* Result rows built client-side by src/lib/saint-list.ts (search and rankings). */
  .saint-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }
  .saint-list li {
    padding: 8px 0;
    border-bottom: 1px dotted var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .saint-list .score {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.8rem;
    color: var(--red);
  }
  .saint-list .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .saint-list.ranked {
    counter-reset: rank;
  }
  .saint-list.ranked li::before {
    counter-increment: rank;
    content: counter(rank);
    min-width: 2.2ch;
    text-align: right;
    font-weight: 700;
    color: var(--gold);
  }
  /* Rank, title and score on one row (the title wraps in its own column), details under the title. */
  .saint-list.ranked li {
    display: grid;
    grid-template-columns: 2.2ch 1fr auto;
  }
  .saint-list.ranked li > :not(.score):not(.meta) {
    grid-column: 2;
  }
  .saint-list.ranked .score {
    grid-column: 3;
    grid-row: 1;
  }
  .saint-list.ranked .meta {
    grid-column: 2 / 4;
  }
</style>
